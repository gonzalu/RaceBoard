# Copy to raceboard.env and edit. The systemd unit reads this file; for a
# manual run, export the same variables in your shell.

# Hold every live update this many seconds so the board doesn't spoil your TV
# stream. The timing feed runs ahead of every broadcast; how far depends on
# your service. Start around 30 and adjust until a pass shows up on the board
# just after you see it.
RACEBOARD_DELAY_S=0

# Time zone for the session times on the between-sessions pages. Empty uses the
# server's own zone.
#RACEBOARD_TZ=America/New_York

# Keep showing a finished session's classification this many minutes after
# its scheduled end, then go back to the schedule and standings. The first is
# for races and sprints, the second for practice and qualifying.
#RACEBOARD_RESULT_HOLD_MIN=90
#RACEBOARD_PRACTICE_HOLD_MIN=30

# Switch to the timing tower this many minutes before a session starts.
#RACEBOARD_PRE_SESSION_MIN=15

# Full-screen alerts during a session: any of overtake, battle, flag, chequered,
# comma separated, or all, or none. They follow the spoiler delay.
#RACEBOARD_ALERTS=all

# Record each live session's raw feed to data/recordings/ (1) or not (0).
# Recordings can be played back with RACEBOARD_REPLAY.
#RACEBOARD_RECORD=1

# Play a recording instead of the live feed, for testing between race weekends.
#RACEBOARD_REPLAY=data/recordings/2026-11-29_Qatar_Grand_Prix_Race.jsonl
#RACEBOARD_REPLAY_SPEED=1

# MotoGP: its timing tower during MotoGP sessions (F1 wins when both are
# running) and its pages between sessions in the week either side of a round.
# 0 turns it off.
#RACEBOARD_MOTOGP=1

# Play a MotoGP recording instead of its live feed, at RACEBOARD_REPLAY_SPEED.
#RACEBOARD_MOTOGP_REPLAY=data/recordings/2026-11-29_MotoGP_VAL_RAC.jsonl
